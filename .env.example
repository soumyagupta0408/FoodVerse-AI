# ---- core ----
ENV=development                      # set to production to enforce a real SECRET_KEY
SECRET_KEY=change-me-in-production   # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://foodverse:foodverse@localhost:5432/foodverse
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ---- storage / limits ----
MEDIA_ROOT=./media
RETENTION_DAYS=30
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
MAX_AUDIO_MB=25
MAX_VIDEO_SECONDS=900
MAX_IMAGE_PIXELS=40000000

# ---- local LLM (Ollama) ----
LLM_PROVIDER=ollama                  # ollama | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---- models (CPU) ----
RECOGNIZER_PROVIDER=hf               # hf | none
RECOGNIZER_MODEL=nateraw/food
FRESHNESS_MODELS_DIR=./models/freshness
FRESHNESS_MIN_CONFIDENCE=0.6
HYGIENE_DETECTOR_PROVIDER=owlvit     # owlvit | none
HYGIENE_DETECTOR_MODEL=google/owlvit-base-patch32
HYGIENE_FRAME_INTERVAL_S=1.0
STT_PROVIDER=faster-whisper          # faster-whisper | none
STT_MODEL=base

# ---- nutrition ----
NUTRITION_SEED_DEMO=true             # approximate demo values only; set false after loading USDA/IFCT

# ---- rate limits (per client IP, per minute) ----
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30

# ---- docker compose only ----
POSTGRES_PASSWORD=foodverse
